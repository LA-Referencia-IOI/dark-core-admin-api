# =============================================================================
# dARK Core Admin API Configuration
# =============================================================================
# Copy this file to .env and configure for your environment

# API Server
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8001

# =============================================================================
# mTLS Configuration (REQUIRED for production)
# =============================================================================
# Set to true in production to require client certificates
MTLS_ENABLED=false

# TLS certificate files (required when MTLS_ENABLED=true)
# TLS_CERT_FILE=/path/to/server.crt
# TLS_KEY_FILE=/path/to/server.key
# TLS_CA_FILE=/path/to/ca.crt

# =============================================================================
# Blockchain Connection
# =============================================================================
# JSON-RPC URL for the dARK blockchain network
DARK_RPC_URL=http://localhost:8545

# Chain ID (1337 for local Besu, adjust for testnet/mainnet)
DARK_CHAIN_ID=1337

# Authority contract address (deployed Authority.sol)
DARK_AUTHORITY_ADDRESS=0x...

# dARK contract address (deployed dARK.sol)
DARK_CONTRACT_ADDRESS=0x...

# Admin private key - KEEP SECRET!
# This account has admin privileges on the Authority contract
DARK_ADMIN_PRIVATE_KEY=0x...

# =============================================================================
# Admin API Specific Settings
# =============================================================================
# Default amount of ETH to fund new authority wallets (in ETH)
DEFAULT_FUND_AMOUNT_ETH=0.01
